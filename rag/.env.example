# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Must have Atlas Vector Search enabled. Replace with your cluster URI.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=bugbaar

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Required if EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_SUMMARIZATION_MODEL=gpt-4o-mini

# ─── NVIDIA NIM (optional alternative embedding provider) ────────────────────
# Required if EMBEDDING_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_SUMMARIZATION_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
JUDGE_LLM_MODEL=meta/llama-3.2-3b-instruct

# ─── Cohere ───────────────────────────────────────────────────────────────────
# Required for Reciprocal Rank Fusion Re-ranking
COHERE_API_KEY=your_cohere_api_key_here
COHERE_RERANK_MODEL=rerank-english-v3.0

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Used for direct file ingestion bypass
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=bugbaar-documents

# ─── Redis / BullMQ ───────────────────────────────────────────────────────────
# Required for background ingestion worker queues
REDIS_URL=redis://localhost:6379

# ─── LlamaParse ───────────────────────────────────────────────────────────────
# Required for advanced multimodal PDF parsing
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# ─── Provider Selection ──────────────────────────────────────────────────────
# Set to 'openai' or 'nvidia' - This dynamically hot-swaps the active provider factory
EMBEDDING_PROVIDER=nvidia
