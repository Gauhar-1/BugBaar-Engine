{
  "name": "bugbaar-engine-rag",
  "version": "1.0.0",
  "description": "BugBaar RAG engine — modular retrieval-augmented generation with MongoDB Atlas, OpenAI, Cohere, Cloudinary, and BullMQ",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "worker": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/workers/index.ts",
    "eval": "ts-node -r tsconfig-paths/register src/eval/run-eval.ts",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@llama-flow/core": "^0.4.4",
    "@llamaindex/cloud": "^4.1.3",
    "@llamaindex/core": "^0.6.21",
    "@llamaindex/env": "^0.1.30",
    "bullmq": "^5.7.0",
    "cloudinary": "^2.5.1",
    "cohere-ai": "^7.13.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "mongodb": "^6.9.0",
    "multer": "^2.3.0",
    "openai": "^4.67.3",
    "uuid": "^14.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.7.5",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
